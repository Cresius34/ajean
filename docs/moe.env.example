# Exemple de preset — `<AJEAN_HOME>\data\presets\<nom>.env`
#
# Un preset est un fichier `CLE=valeur`, un par ligne, posé dans `data\presets\`.
# C'est lui qui déclare un moteur : **sans preset, le moteur n'apparaît pas dans
# la liste**, et une liste vide n'est pas une panne.
#
# Les chemins d'un preset sont relatifs à `AJEAN_HOME` (le dossier qui contient
# `data\`) : `models\…`, `moe\…`, `backends\…`. Le `data\` n'est jamais dans le
# chemin.
#
# Trois modèles de preset ci-dessous. Le premier est un preset llama.cpp ordinaire
# (bloc A). Le deuxième est un MoE « Strata » installé depuis l'onglet Moteur sur
# Windows (bloc B) : c'est `ENGINE=moe` + `MOE_RUNTIME=strata-windows` qui en font
# un MoE. Le troisième montre les clés mémoire (bloc C), acceptées par les deux.


# ─── BLOC A — preset llama.cpp (aucune clé MOE_*) ──────────────────────────
# NAME=Swift 1.5
BIN=backends\llama-b1346-windows-rocm-gfx120X-x64\llama-server.exe
MODEL=models\Swift-1.5-Qwen3.8-27B-Uncensored-BF16.Q4_K_S.gguf
MMPROJ=mmproj-Swift-1.5-Qwen3.8-27B-F16.gguf
CTX=128000
THREADS=16
HOST=127.0.0.1
PORT=18080
REASONING=on
EXTRA_ARGS="--device ROCm0 --flash-attn on --no-mmproj-offload --jinja --kv-unified --spec-type draft-mtp --load-mode mmap+mlock"
KV_TYPE_K=q8_0
KV_TYPE_V=q8_0
TOP_K=20
TOP_P=0.95
MIN_P=0
PRESENCE_PENALTY=0
REPEAT_PENALTY=1


# ─── BLOC B — MoE « Strata » sur Windows ───────────────────────────────────
# Backend : `hip` (AMD) ou `cuda` (NVIDIA) — pas de Vulkan pour Strata.
# Toolkit : `12` ou `13`, utilisé pour le backend CUDA.
# Contexte : 32 768 à 262 144 tokens par paliers de 4 096, **86 016 par défaut**.
# Réserve vidéo : 0 à 65 536 Mo, **4096 Mo par défaut**.
# Le paquet HIP livré sur Windows est **texte uniquement** : la vision doit être
# activée sur un paquet CUDA.
# MOE_CONFIG désigne le fichier de configuration du moteur, posé dans le dossier
# du source. Il n'existe pas de clé `MOE_MODEL` : le modèle est dans ce JSON.
# NAME=FLASH NEXT SWIFT 1.5 IQ3_XXS · HIP
ENGINE=moe
MOE_RUNTIME=strata-windows
MOE_BACKEND=hip
MOE_TOOLKIT=13
MOE_SOURCE=moe\strata-0.1.44.1-hip
MOE_PYTHON=moe\strata-0.1.44.1-hip\python\python.exe
MOE_CONFIG=moe\strata-0.1.44.1-hip\strata-swift-iq3_xxs.json
MOE_KV=int8
MOE_SPEC=3
MOE_VISION=0
MOE_VRAM_RESERVE=4096
CTX=126976
HOST=127.0.0.1
PORT=18080
REASONING=on


# ─── BLOC C — mémoire sémantique (les deux moteurs) ────────────────────────
# MEMORY_SYSTEM : `classic` (les mots) ou `hybrid` (les mots et le sens).
# MEM_MODE      : `off`, `ondemand`, `search`, `always` — et réglable par projet.
# Préfixe des clés d'embeddings : `MEMORY_EMBED_` tout court. Les clés
# `MEMORY_MODE` et `MEMORY_EMBED_DIMS` **n'existent pas**.
# Provider : `llama_cpp` (défaut) ou `transformers`. Device : `cpu` (défaut) ou
# `gpu`. Dimensions valides : 128, 256, 512, 768. Modalités : texte, image,
# audio, video.
MEMORY_SYSTEM=hybrid
MEM_MODE=ondemand
MEMORY_EMBED_MODEL=models\embeddinggemma-2-full
MEMORY_EMBED_BIN=embedding-python\python.exe
MEMORY_EMBED_PROVIDER=transformers
MEMORY_EMBED_DEVICE=cpu
MEMORY_EMBED_GPU_DEVICE=ROCm0
MEMORY_EMBED_MODALITIES=text
MEMORY_EMBED_THREADS=8
MEMORY_EMBED_DIMENSIONS=768
