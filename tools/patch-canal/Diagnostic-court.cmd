@echo off
rem Diagnostic-court.cmd - LECTURE SEULE, sans droits administrateur.
rem Trois questions : quel dossier tourne, EmbeddingGemma 2, moteur Strata.
rem Rien n'est ecrit, aucun service arrete, rien n'est telecharge.
powershell -NoProfile -Command "Write-Output '1) QUEL DOSSIER TOURNE'; foreach ($p in 18090,18190,18080,18081) { $c=@(Get-NetTCPConnection -LocalPort $p -State Listen -EA SilentlyContinue); if (-not $c.Count) { Write-Output ('   ' + $p + ' : rien') } else { foreach ($id in ($c | %%{ $_.OwningProcess } | Select -Unique)) { $w=Get-CimInstance Win32_Process -Filter \"ProcessId=$id\" -EA SilentlyContinue; Write-Output ('   ' + $p + ' : ' + $w.ExecutablePath) } } }; Write-Output '2) BINAIRE DE CHAQUE DOSSIER'; foreach ($d in (Get-ChildItem C:\ProgramData -Directory -Filter 'Ajean*')) { $x=Join-Path $d.FullName 'ajean.exe'; if (Test-Path -LiteralPath $x) { $v=[Diagnostics.FileVersionInfo]::GetVersionInfo($x); Write-Output ('   ' + $d.Name + ' -> ' + $v.ProductVersion) } else { Write-Output ('   ' + $d.Name + ' -> pas de binaire') } }; Write-Output '3) EMBEDDINGGEMMA (dims 512 = EG2, 768 = ancien)'; try { $s=Invoke-RestMethod http://127.0.0.1:18090/api/embeddings -TimeoutSec 8; Write-Output ('   pret=' + $s.ready + ' dims=' + $s.config.dimensions + ' modele=' + $s.config.model) } catch { Write-Output '   18090 sans reponse' }; Write-Output '4) MOTEUR STRATA'; try { $m=Invoke-RestMethod http://127.0.0.1:18080/health -TimeoutSec 8; Write-Output ('   service=' + $m.service + ' loaded=' + $m.loaded + ' modele=' + $m.model) } catch { Write-Output '   18080 : rien = Strata NON en service' }; Write-Output '5) DOSSIERS data\moe'; foreach ($d in (Get-ChildItem C:\ProgramData -Directory -Filter 'Ajean*')) { $q=Join-Path $d.FullName 'data\moe'; if (Test-Path -LiteralPath $q) { foreach ($x in (Get-ChildItem -LiteralPath $q -Directory)) { Write-Output ('   ' + $d.Name + ' -> ' + $x.Name) } } }; Write-Output '6) PAQUET 18161 (sha attendu 9FF0415C...)'; foreach ($d in (Get-ChildItem C:\ProgramData -Directory -Filter 'Ajean*')) { $x=Join-Path $d.FullName 'patch-canal-18161\ajean.exe'; if (Test-Path -LiteralPath $x) { try { Write-Output ('   ' + $d.Name + ' -> ' + (Get-FileHash $x -Algorithm SHA256).Hash.Substring(0,16)) } catch { Write-Output ('   ' + $d.Name + ' -> LECTURE REFUSEE par l antimalware') } } else { Write-Output ('   ' + $d.Name + ' -> pas de paquet') } }"
