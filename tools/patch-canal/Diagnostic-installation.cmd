@echo off
rem Diagnostic-installation.cmd - LECTURE SEULE. Ecrit le 2026-10-28 pour le point
rem sur EmbeddingGemma 2 et le moteur Strata chez la voisine. Aucune ecriture,
rem aucun arret, aucun telechargement. A copier-coller tel quel dans une fenetre
rem cmd (pas besoin de droits administrateur).
powershell -NoProfile -Command "$OutputEncoding=[Text.Encoding]::UTF8; Write-Output '== DOSSIERS Ajean et version du binaire =='; foreach ($d in (Get-ChildItem C:\ProgramData -Directory -Filter 'Ajean*')) { $x=Join-Path $d.FullName 'ajean.exe'; if (Test-Path -LiteralPath $x) { $v=[Diagnostics.FileVersionInfo]::GetVersionInfo($x); $i=Get-Item -LiteralPath $x; try { $h=(Get-FileHash -LiteralPath $x -Algorithm SHA256).Hash.Substring(0,16) } catch { $h='LECTURE_REFUSEE' }; Write-Output ('  ' + $d.Name + ' -> ' + $v.ProductVersion + ' | ' + $i.Length + ' o | ' + $h) } else { Write-Output ('  ' + $d.Name + ' -> pas de binaire') } }; Write-Output '== QUEL DOSSIER TOURNE (ports en ecoute) =='; foreach ($p in 18080,18081,18090,18190) { $c=@(Get-NetTCPConnection -LocalPort $p -State Listen -EA SilentlyContinue); if (-not $c.Count) { Write-Output ('  ' + $p + ' : rien') } else { foreach ($id in ($c | ForEach-Object { $_.OwningProcess } | Select-Object -Unique)) { $w=Get-CimInstance Win32_Process -Filter \"ProcessId=$id\" -EA SilentlyContinue; Write-Output ('  ' + $p + ' : ' + $w.ExecutablePath) } } }; Write-Output '== ENCODEUR D EMBEDDINGS (dimensions attendues : 512 = EG2, 768 = ancien Gemma) =='; try { $s=Invoke-RestMethod http://127.0.0.1:18090/api/embeddings -TimeoutSec 8; Write-Output ('  pret=' + $s.ready + ' running=' + $s.running + ' dims=' + $s.config.dimensions + ' provider=' + $s.config.provider + ' modele=' + $s.config.model) } catch { Write-Output ('  sans reponse : ' + $_.Exception.Message) }; Write-Output '== MOTEUR MoE STRATA (dossiers installes) =='; foreach ($d in (Get-ChildItem C:\ProgramData -Directory -Filter 'Ajean*')) { $m=Join-Path $d.FullName 'data\moe'; if (Test-Path -LiteralPath $m) { foreach ($q in (Get-ChildItem -LiteralPath $m -Directory)) { Write-Output ('  ' + $d.Name + ' -> ' + $q.Name) } } }; Write-Output '== MOTEUR : 18080 repond-il (le /health de Strata, pas /v1/models qui est protege) =='; try { $m=Invoke-RestMethod http://127.0.0.1:18080/health -TimeoutSec 8; Write-Output ('  service=' + $m.service + '  loaded=' + $m.loaded + '  modele=' + $m.model + '  contexte_max=' + $m.max_context + '  cle_exigee=' + $m.api_key) } catch { Write-Output '  18080 : rien ne repond = moteur Strata NON en service (le dossier existe ne veut pas dire qu il tourne)' }; Write-Output '== CYCLE DE VIE DU MOTEUR (dernier journal Strata) =='; foreach ($d in (Get-ChildItem C:\ProgramData -Directory -Filter 'Ajean*')) { $l=Join-Path $d.FullName 'data\moe\logs'; if (Test-Path -LiteralPath $l) { foreach ($f in (Get-ChildItem -LiteralPath $l -File -EA SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 2)) { Write-Output ('  ' + $f.Name + '  ' + $f.LastWriteTime.ToString('s') + '  ' + $f.Length + ' o') } } }; Write-Output '== OUTILS DU CANAL poses dans data\scripts (6 attendus) =='; foreach ($d in (Get-ChildItem C:\ProgramData -Directory -Filter 'Ajean*')) { $n=0; foreach ($o in 'cabler-canal.ps1','Ouvrir-Canal.ps1','Ouvrir-PareFeu-Canal.cmd','Verifier-Outils-Canal.ps1','Verifier-Collisions-Casse.ps1','Encodages.ps1') { if (Test-Path -LiteralPath (Join-Path $d.FullName ('data\scripts\' + $o))) { $n++ } }; if (Test-Path -LiteralPath (Join-Path $d.FullName 'ajean.exe')) { Write-Output ('  ' + $d.Name + ' -> ' + $n + ' / 6') } }; Write-Output '== PAQUET 18161 present et lisible (sha attendu 9FF0415C...) =='; foreach ($d in (Get-ChildItem C:\ProgramData -Directory -Filter 'Ajean*')) { $x=Join-Path $d.FullName 'patch-canal-18161\ajean.exe'; if (Test-Path -LiteralPath $x) { try { Write-Output ('  ' + $d.Name + ' -> ' + (Get-FileHash -LiteralPath $x -Algorithm SHA256).Hash.Substring(0,16)) } catch { Write-Output ('  ' + $d.Name + ' -> LECTURE REFUSEE par l antimalware') } } else { Write-Output ('  ' + $d.Name + ' -> pas de paquet') } }; Write-Output '== MODELES EMBEDDINGGEMMA sur disque =='; foreach ($d in (Get-ChildItem C:\ProgramData -Directory -Filter 'Ajean*')) { $m=Join-Path $d.FullName 'data\models'; if (Test-Path -LiteralPath $m) { foreach ($f in (Get-ChildItem -LiteralPath $m -Recurse -File -EA SilentlyContinue | Where-Object { $_.Name -match 'gemma|embed' })) { Write-Output ('  ' + $f.FullName + '  ' + $f.Length + ' o') } } }; Write-Output '== DETECTIONS ANTIVIRUS sur nos fichiers =='; try { Get-WinEvent -LogName 'Microsoft-Windows-Windows Defender/Operational' -MaxEvents 300 -EA Stop | Where-Object { $_.Id -in 1116,1117 } | Select-Object -First 4 | ForEach-Object { $c=[regex]::Match($_.Message,'Chemin\s*:\s*([^;]+)').Groups[1].Value.Trim(); $n=[regex]::Match($_.Message,'Nom\s*:\s*(.+)').Groups[1].Value.Split([char]10)[0].Trim(); Write-Output ('  ' + $_.TimeCreated.ToString('s') + ' | ' + $n + ' | ' + $c) } } catch { Write-Output ('  lecture des journaux Defender refusee (il faut Administrateur)') }"
